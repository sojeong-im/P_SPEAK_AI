# Azure Speech SDK (Cognitive Services → Speech) — used for free-speech STT only
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=koreacentral
NEXT_PUBLIC_AZURE_SPEECH_KEY=your_azure_speech_key_here
NEXT_PUBLIC_AZURE_SPEECH_REGION=koreacentral

# SpeechSuper (Korean pronunciation evaluation) — server-only, never expose
SPEECHSUPER_APP_KEY=your_speechsuper_app_key
SPEECHSUPER_SECRET_KEY=your_speechsuper_secret_key
SPEECHSUPER_BASE_URL=https://api.speechsuper.com
SPEECHSUPER_MAX_CONCURRENCY=5

# Gemini API (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Neon PostgreSQL (Vercel Integrations > Neon에서 자동 주입됨)
DATABASE_URL=postgresql://...

# Admin
ADMIN_PASSWORD=ydp12000
NEXT_PUBLIC_ADMIN_PASSWORD=ydp12000
